# ─── Mokshita Backend — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to Git.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── PostgreSQL / Supabase Database ──────────────────────────────────────────
# For Supabase: use the "Transaction Pooler" connection string from
# Project Settings → Database → Connection string → Node.js
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=your_supabase_connection_string_here

# Alternatively, set individual fields (used by db.js Pool when DATABASE_URL is absent)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mokshita_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (required in production).
# Development also allows localhost:3001, 5173, 5500 automatically.
ALLOWED_ORIGINS=https://mokshita.com,https://www.mokshita.com,https://admin.mokshita.com

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000

# ─── Supabase Storage (for admin product image uploads) ───────────────────────
# Use the SERVICE ROLE KEY — not the anon/public key.
# Found in: Project Settings → API → service_role (secret)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_BUCKET=product-images

# ─── Razorpay Payment Gateway ─────────────────────────────────────────────────
# Found in: Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Found in: Razorpay Dashboard → Webhooks → your webhook → Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
