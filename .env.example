# ─── Mokshita Backend — Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to Git.
#
# ─── PLATFORM NOTES ──────────────────────────────────────────────────────────
# Railway/Render auto-set PORT — do NOT set PORT manually in the dashboard.
# Set NODE_ENV=production in the platform's environment variable UI.

# ─── Server ───────────────────────────────────────────────────────────────────
# PORT is auto-assigned by Railway / Render. Only set locally.
PORT=3000
NODE_ENV=development   # Change to: production (in Railway/Render dashboard)

# ─── PostgreSQL / Supabase Database ──────────────────────────────────────────
# RECOMMENDED (Production): Use the Supabase "Transaction Pooler" connection string.
# Found in: Supabase Dashboard → Project Settings → Database → Connection string → Node.js
# IMPORTANT: Use port 6543 (Transaction Pooler), NOT 5432 (Direct connection).
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=your_supabase_transaction_pooler_connection_string_here

# Alternative: Set individual fields (used by db.js Pool when DATABASE_URL is absent)
# These are used for local development only.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mokshita_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ─── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random 64-character string in production!
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (required in production).
# Add your Vercel deployment URL and any custom domain here.
# Example: https://mokshita.vercel.app,https://mokshita-enterprises.com,https://www.mokshita-enterprises.com
ALLOWED_ORIGINS=https://mokshita.vercel.app,https://mokshita-enterprises.com,https://www.mokshita-enterprises.com

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000

# ─── Supabase Storage (for admin product image uploads) ───────────────────────
# Use the SERVICE ROLE KEY — not the anon/public key.
# Found in: Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_BUCKET=product-images

# ─── Razorpay Payment Gateway ─────────────────────────────────────────────────
# Found in: Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Found in: Razorpay Dashboard → Webhooks → your webhook → Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
