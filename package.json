{
  "name": "mokshita-backend",
  "version": "1.0.0",
  "description": "Mokshita Enterprises - Production-ready Node.js/Express backend with PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node src/config/migrate.js",
    "db:migrate": "node src/config/migrate.js",
    "db:seed": "node src/seeds/seed-all.js",
    "db:setup": "node src/config/migrate.js && node src/seeds/seed-all.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "postgresql",
    "jwt"
  ],
  "author": "Mokshita Enterprises",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "pg": "^8.12.0",
    "razorpay": "^2.9.6",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
